{{- define "layout" -}}
<!DOCTYPE html>
<html lang="{{ .Locale.Lang }}" dir="{{ .Dir }}">
    <head>
        <meta charset="utf-8">
        <title>{{ if .Title }}{{ .Title }} · {{ end }}OpenGoPaste</title>
        <meta name="robots" content="noindex">
        <meta name="referrer" content="no-referrer">
        <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
        <link rel="apple-touch-icon" sizes="180x180" href="/static/img/favicon/apple-touch-icon.png">
        <link rel="icon" type="image/png" sizes="32x32" href="/static/img/favicon/favicon-32x32.png">
        <link rel="icon" type="image/png" sizes="16x16" href="/static/img/favicon/favicon-16x16.png">
        <link rel="manifest" href="/static/img/favicon/site.webmanifest">
        <link rel="mask-icon" href="/static/img/favicon/safari-pinned-tab.svg" color="#5bbad5">
        <link rel="shortcut icon" href="/static/img/favicon/favicon.ico">
        <meta name="msapplication-TileColor" content="#da532c">
        <meta name="msapplication-config" content="/static/img/favicon/browserconfig.xml">
        <meta name="theme-color" content="#662d91">
        <link rel="stylesheet" href="/static/css/color.css">
        <link rel="stylesheet" href="/static/css/app.css">
        {{- template "stylesheets" .Data -}}
        {{- if (ne .CustomCss "") -}}
        <link rel="stylesheet" href="{{.CustomCss}}">
        {{- end -}}
    </head>
    <body>
        <header>
            <div class="logo">
                <a href="/">
                    <img width="88" height="88" src="/static/img/logo3.svg" alt="{{ T "layout.logo_alt" }}">
                </a>
            </div>
            <div class="title">
                <h1>OpenGo<span class="title">Paste</span></h1>
                <p class="tagline">{{ T "layout.tagline" }}</p>
            </div>
        </header>
        <main>
            {{/* The pages that need JavaScript carry their own noscript notice:
            about and the error page work perfectly well without it, and telling
            their readers that a form is locked would be a lie. */}}
            {{- template "content" .Data -}}
        </main>
        <footer>
            {{ TH "layout.footer" }}
        </footer>
        {{- template "javascripts" .Data -}}
    </body>
</html>
{{- end -}}
