{{- define "stylesheets" -}}
<link rel="stylesheet" href="{{ asset "/css/error.css" }}">
{{- end -}}

{{define "content"}}
<div id="error">
    {{/* The layout already carries the h1 of the service: this is the heading
    of the page inside it, not a second top level one. */}}
    <h2 class="title">{{.Title}}</h2>
    <div class="message">{{.Message}}</div>
    <div class="logo"><img src="{{ asset "/img/logo2.svg" }}" width="350" height="350" alt=""></div>
</div>
{{end}}

{{- define "javascripts" -}}
{{- end -}}
