{{- define "stylesheets" -}}
<link rel="stylesheet" href="/static/css/about.css">
{{- end -}}

{{- define "content" -}}
    <div id="about">
        <div class="logos">
            <div class="logo"><img src="/static/img/logo.svg" width="350" /></div>
            <div class="logo"><img src="/static/img/logo2.svg" width="350" /></div>
        </div>
        <p class="description">
            {{ T "about.intro" }}
        </p>
        <p class="description">
            {{ T "about.encryption" }}
        </p>
        <div class="authors">
            {{ T "about.built_by" }}
            <div class="author dev" data-content="{{ T "about.role_development" }}">Simon Leblanc</div>
            <div class="author design" data-content="{{ T "about.role_design" }}">Lucie Lenfant</div>
        </div>
        <div class="open-source">
            <p>
                {{ T "about.free_software" }}
                <ul>
                    <li>{{ TH "about.code_license" }}</li>
                    <li>{{ TH "about.logos_license" }}</li>
                </ul>
            </p>
            <ul>
                <li><a class="link" href="https://github.com/leblanc-simon/open-go-paste"
                        title="{{ T "about.show_source" }}">{{ T "about.source_software" }}</a>
                </li>
                <li><a class="link" href="/static/img/logo.svg"
                        title="{{ T "about.show_source" }}">{{ T "about.source_logo_official" }}</a>
                </li>
                <li><a class="link" href="/static/img/logo3.svg"
                        title="{{ T "about.show_source" }}">{{ T "about.source_logo_alternative" }}</a>
                </li>
                <li><a class="link" href="/static/img/logo2.svg"
                        title="{{ T "about.show_source" }}">{{ T "about.source_logo_unofficial" }}</a>
                        ({{ TH "about.logo_unofficial_credit" }})
                </li>
        </div>
    </div>
{{- end -}}

{{- define "javascripts" -}}
{{- end -}}
