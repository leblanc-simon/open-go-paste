{{- define "stylesheets" -}}
<link rel="stylesheet" href="{{ asset "/css/about.css" }}">
{{- end -}}

{{- define "content" -}}
    <div id="about">
        {{/* Decorative: the licences and the credits below say in words what
        these two drawings show. */}}
        <div class="logos">
            <div class="logo"><img src="{{ asset "/img/logo.svg" }}" width="350" height="350" alt=""></div>
            <div class="logo"><img src="{{ asset "/img/logo2.svg" }}" width="350" height="350" alt=""></div>
        </div>
        <p class="description">
            {{ T "about.intro" }}
        </p>
        <p class="description">
            {{ T "about.encryption" }}
        </p>
        <div class="authors">
            {{ T "about.built_by" }}
            <div class="author dev" data-content="{{ T "about.role_development" }}">Simon Leblanc</div>
            <div class="author design" data-content="{{ T "about.role_design" }}">Lucie Lenfant</div>
        </div>
        <div class="open-source">
            <p>{{ T "about.free_software" }}</p>
            <ul>
                <li>{{ TH "about.code_license" }}</li>
                <li>{{ TH "about.logos_license" }}</li>
            </ul>
            <ul>
                <li>
                    <a class="link" href="https://github.com/leblanc-simon/open-go-paste"
                        title="{{ T "about.show_source" }}">{{ T "about.source_software" }}</a>
                </li>
                <li>
                    <a class="link" href="{{ asset "/img/logo.svg" }}"
                        title="{{ T "about.show_source" }}">{{ T "about.source_logo_official" }}</a>
                </li>
                <li>
                    <a class="link" href="{{ asset "/img/logo3.svg" }}"
                        title="{{ T "about.show_source" }}">{{ T "about.source_logo_alternative" }}</a>
                </li>
                <li>
                    <a class="link" href="{{ asset "/img/logo2.svg" }}"
                        title="{{ T "about.show_source" }}">{{ T "about.source_logo_unofficial" }}</a>
                    ({{ TH "about.logo_unofficial_credit" }})
                </li>
            </ul>
        </div>
    </div>
{{- end -}}

{{- define "javascripts" -}}
{{- end -}}
