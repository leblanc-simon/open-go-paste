{{- define "stylesheets" -}}
{{- end -}}

{{- define "content" -}}
    {{/* Every label app.js has to write into the page is handed over already
    translated, through data-* attributes: a Content-Security-Policy without
    'unsafe-inline' rules out an inline script carrying a catalogue. */}}
    <div id="messages" hidden
        data-save-error="{{ T "index.save_error" }}"
        data-network-error="{{ T "error.network" }}"
        data-rate-limited="{{ T "error.rate_limited" }}"
        data-too-large="{{ T "error.request_too_large" }}"
        data-encryption-failed="{{ T "index.encryption_failed" }}"
        data-insecure-context="{{ T "error.insecure_context" }}"
        data-copied="{{ T "index.link_copied" }}"
        data-copy-failed="{{ T "index.copy_failed" }}"
        data-saving="{{ T "index.saving" }}"
        data-max-content-bytes="{{ .MaxContentBytes }}"
    ></div>

    {{/* app.js unlocks the form once it has checked the browser can encrypt.
    This is what explains the lock to whoever has no JavaScript at all. */}}
    <noscript>
        <p class="notice notice--blocking">{{ T "error.javascript_required" }}</p>
    </noscript>

    <div id="link" role="status" hidden>
        <div class="title">{{ T "index.link_ready" }}</div>
        <div class="link"></div>
        <div class="link-actions">
            <button type="button" id="copy-link" aria-label="{{ T "index.copy_action" }}">
                <svg viewBox="0 0 512 512" width="24" height="24" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg"><g><polygon points="304,96 288,96 288,176 368,176 368,160 304,160  "/><path d="M325.3,64H160v48h-48v336h240v-48h48V139L325.3,64z M336,432H128V128h32v272h176V432z M384,384H176V80h142.7l65.3,65.6V384   z"/></g></svg>
            </button>
            {{/* The address only exists once the paste is encrypted and stored,
            so app.js sets href before it reveals #link. Until then the whole
            block is hidden, and an anchor without href is unreachable. */}}
            <a id="send-link" aria-label="{{ T "index.send_by_email" }}">
                <svg viewBox="0 0 512 512" width="24" height="24" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg"><path d="M460.6 147.3L353 256.9c-.8.8-.8 2 0 2.8l75.3 80.2c5.1 5.1 5.1 13.3 0 18.4-2.5 2.5-5.9 3.8-9.2 3.8s-6.7-1.3-9.2-3.8l-75-79.9c-.8-.8-2.1-.8-2.9 0L313.7 297c-15.3 15.5-35.6 24.1-57.4 24.2-22.1.1-43.1-9.2-58.6-24.9l-17.6-17.9c-.8-.8-2.1-.8-2.9 0l-75 79.9c-2.5 2.5-5.9 3.8-9.2 3.8s-6.7-1.3-9.2-3.8c-5.1-5.1-5.1-13.3 0-18.4l75.3-80.2c.7-.8.7-2 0-2.8L51.4 147.3c-1.3-1.3-3.4-.4-3.4 1.4V368c0 17.6 14.4 32 32 32h352c17.6 0 32-14.4 32-32V148.7c0-1.8-2.2-2.6-3.4-1.4z"/><path d="M256 295.1c14.8 0 28.7-5.8 39.1-16.4L452 119c-5.5-4.4-12.3-7-19.8-7H79.9c-7.5 0-14.4 2.6-19.8 7L217 278.7c10.3 10.5 24.2 16.4 39 16.4z"/></svg>
            </a>
            {{/* Inside the actions so it can be hung under the button that was
            pressed, rather than at the bottom of the block. */}}
            <span class="copy-feedback" role="status"></span>
        </div>
        <p class="link-warning">{{ T "index.link_warning" }}</p>
    </div>

    <p id="paste-error" class="notice notice--error" role="alert" hidden></p>

    <form method="post" action="./" name="paste">
        {{/* Locked until app.js has confirmed the browser can encrypt. A
        disabled fieldset submits none of its fields, so a browser without
        JavaScript — or without a usable Web Crypto, which is the case over
        plain HTTP — cannot send the text in the clear by pressing Enter. */}}
        <fieldset id="paste-fields" disabled>
            <div class="form-item">
                <label for="max_time">{{ T "index.expire_in" }}</label>
                <select name="max_time" id="max_time" required>
                    {{- range .AllowedTimes -}}
                    <option value="{{.DurationString}}" {{if eq .Default true}}selected="selected"{{end}}>{{.Label}}</option>
                    {{- end -}}
                </select>
            </div>
            <div class="form-item">
                <label for="type">{{ T "index.format" }}</label>
                <select name="type" id="type" required>
                    {{- range .AllowedTypes -}}
                    <option value="{{.Value}}" {{if eq .Default true}}selected="selected"{{end}}>{{.Label}}</option>
                    {{- end -}}
                </select>
            </div>
            <div class="form-item form-item--with-hint">
                <label for="max_read">{{ T "index.max_read" }}</label>
                <input type="number" value="1" name="max_read" id="max_read" min="0" max="500"
                    aria-describedby="max_read_hint" required>
                <small id="max_read_hint" class="hint">{{ T "index.max_read_hint" }}</small>
            </div>
            <div class="form-item form-paste">
                <label for="paste">{{ T "index.content" }}</label>
                <textarea name="paste" id="paste" required></textarea>
            </div>
            <div class="form-item form-action">
                <button type="submit" data-label="{{ T "index.save" }}">{{ T "index.save" }}</button>
            </div>
        </fieldset>
    </form>
{{- end -}}

{{- define "javascripts" -}}
    {{/* app.js imports these two, so without the hint the browser only finds
    out they exist once it has parsed app.js: one round trip in series before
    anything can be decrypted.

    These two urls stay unstamped, unlike every other asset: app.js imports them
    relatively and a module url carries no query along, so a stamped hint would
    preload something the import never asks for and the file would travel twice.
    TestTheModuleHintsMatchWhatTheScriptImports holds the two together. */}}
    <link rel="modulepreload" href="/static/js/crypto.js">
    <link rel="modulepreload" href="/static/js/sanitize.js">
    <script src="{{ asset "/js/app.js" }}" type="module"></script>
{{- end -}}
