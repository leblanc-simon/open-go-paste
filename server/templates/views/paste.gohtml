{{- define "stylesheets" -}}
    {{- if or (eq .Type "code") (eq .Type "markdown") -}}
    <link rel="stylesheet" href="/static/css/highlightjs/androidstudio.css" />
    {{- end -}}
{{- end -}}

{{- define "content" -}}
    <div class="paste-information show"
        data-information="{{ trans "This message can be viewed again §nBAvailableRead§ times or up to §dateAvailable§ at §hourAvailable§." }}"
        data-information-no-nb-read="{{ trans "This message can be viewed up to §dateAvailable§ at §hourAvailable§." }}"
        data-last-read="{{ trans "This message is available for the last time. You will not be able to consult it later." }}"
    ></div>
    {{/* The paste is handed over through data-* attributes rather than an inline
    script, which is what allows a Content-Security-Policy without
    'unsafe-inline'. ExpireTime is formatted as RFC 3339 so that the browser
    parses a date instead of rebuilding one from Go's display format. */}}
    <div id="paste-content"
        data-encrypted-value="{{ .Data }}"
        data-nb-of-read-allowed="{{ .AllowedNumberOfRead }}"
        data-nb-of-read="{{ .NumberOfRead }}"
        data-expire-time="{{ .ExpireTime.UTC.Format "2006-01-02T15:04:05Z" }}"
        data-type="{{ .Type }}"
    ></div>
{{- end -}}

{{- define "javascripts" -}}
    {{- if or (eq .Type "code") (eq .Type "markdown") -}}
    <script src="/static/js/highlight.pack.js"></script>
    {{- end -}}
    {{- if eq .Type "markdown" -}}
    <script src="/static/js/showdown.min.js"></script>
    {{- end -}}
    <script src="/static/js/app.js" type="module"></script>
{{- end -}}
